{
  "400_invalid_request": {
    "status": 400,
    "body": {
      "error": {
        "code": "invalid-request",
        "message": "job_path must be a repo-relative path under jobs/*.json without '..' traversal.",
        "details": {
          "field": "job_path",
          "received": "../outside.json"
        }
      }
    }
  },
  "404_not_found": {
    "status": 404,
    "body": {
      "error": {
        "code": "job-not-found",
        "message": "No loop or archived result matches job_id 'job-missing-999'.",
        "details": {
          "job_id": "job-missing-999"
        }
      }
    }
  },
  "409_revision_conflict": {
    "status": 409,
    "body": {
      "error": {
        "code": "stale-revision",
        "message": "Stage configuration revision mismatch: client sent rev-stages-20261103-06, but server is at rev-stages-20261103-08.",
        "details": {
          "expected_revision": "rev-stages-20261103-08",
          "received_revision": "rev-stages-20261103-06"
        }
      }
    }
  },
  "422_rule_refusal": {
    "status": 422,
    "body": {
      "error": {
        "code": "profile-refusal",
        "message": "Active profile 'test' forbids planner invocations and paid OpenRouter calls.",
        "details": {
          "profile": "test",
          "stage": "planner",
          "rule": "no_paid_or_planner_in_test"
        }
      }
    }
  },
  "503_backend_unavailable": {
    "status": 503,
    "body": {
      "error": {
        "code": "sandbox-unavailable",
        "message": "Docker rootless daemon is unreachable or sandbox image satvik-sandbox:rev4-py312 is missing.",
        "details": {
          "docker_ok": false
        }
      }
    }
  }
}
