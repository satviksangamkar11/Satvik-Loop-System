{
  "name": "satvik-loop-control-center-ui",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "VITE_DATA_MODE=mock vite",
    "dev:live": "VITE_DATA_MODE=live vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
